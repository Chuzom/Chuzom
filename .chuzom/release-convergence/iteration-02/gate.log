                    model="(denied)",
                    provider="(denied)",
                    cost_usd=0.0,
                    cached=False,
                    detail_extras={
                        "correlation_id": correlation_id,
                        "outcome": "rbac_denied",
                        "permission": "route_prompt",
                        "rbac_mode": _rbac_mode,
                    },
